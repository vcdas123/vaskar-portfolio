# One env file for the whole monorepo. Copy to `.env` at the repository root.
# Read by the API (dotenv), Prisma (dotenv-cli) and Vite (envDir).

NODE_ENV=development
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres. Spell out the role — Prisma does not fall back to your OS user.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Used only by `npm run test:api`. Must be local: the suite truncates and re-seeds.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/performance_terminal_test?schema=public"

# Development only; the deployment serves the API and site from one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
JSON_BODY_LIMIT=16kb

# LOCAL DEVELOPMENT ONLY. Do NOT copy this value into a deployment: it is inlined
# at build time, so a deployed bundle would call your machine and the browser would
# report it as a CORS error. In a deployment either leave it unset or set it to /api.
VITE_API_BASE_URL=http://localhost:4100/api
